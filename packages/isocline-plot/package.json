    "preview": "vite dev examples --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "@observablehq/plot": "^0.6.17",
    "isocline": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
