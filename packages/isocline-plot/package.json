{
  "name": "isocline-plot",
  "version": "0.1.0",
  "description": "Observable Plot visualization layer for isocline results",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielMcSheehy/isocline.git",
    "directory": "packages/isocline-plot"
  },
  "keywords": [
    "isocline",
    "observable-plot",
    "visualization",
    "time-series"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
