{
  "name": "isocline-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:wasm": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../isocline/dist/isocline.wasm','public/isocline.wasm');console.log('[demo] copied ../isocline/dist/isocline.wasm -> public/isocline.wasm')\"",
    "prebuild": "npm run copy:wasm",
    "predev": "npm run copy:wasm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "isocline": "0.1.0",
    "isocline-plot": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
